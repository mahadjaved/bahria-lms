# Secret used to encrypt the session cookie. The session (including the
# Bahria cookie jar) travels with the browser in an AES-256-GCM-encrypted
# cookie that is re-issued on every response, so it works on any server
# instance. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional override for the Bahria portal base URL
BAHRIA_BASE_URL=https://cms.bahria.edu.pk
